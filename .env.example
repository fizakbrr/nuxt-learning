# Supabase project settings (Project Settings > Data API in the Supabase dashboard)
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-publishable-key

# Supabase Postgres (Project Settings > Database > Connect in the Supabase dashboard)
DATABASE_URL=postgresql://postgres.your-project:your-password@your-pooler-host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
