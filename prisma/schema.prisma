generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  slug    String   @id
  title   String
  premium Boolean  @default(false)
  recipes Recipe[]
}

model Recipe {
  slug         String
  title        String
  cookTime     String
  description  String
  ingredients  String[]
  steps        String[]
  categorySlug String
  category     Category   @relation(fields: [categorySlug], references: [slug])
  favorites    Favorite[]

  @@id([categorySlug, slug])
}

model Favorite {
  id           Int      @id @default(autoincrement())
  userId       String
  categorySlug String
  recipeSlug   String
  favorited    Boolean
  recipe       Recipe   @relation(fields: [categorySlug, recipeSlug], references: [categorySlug, slug], onDelete: Cascade)

  @@unique([userId, categorySlug, recipeSlug])
}

// mockPaymentId stands in for a real processor's payment/order id.
// One row per checkout attempt, no per-category FK: there's one premium product today.
model Purchase {
  id            Int      @id @default(autoincrement())
  userId        String
  mockPaymentId String   @unique
  amount        Int
  currency      String
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
}
