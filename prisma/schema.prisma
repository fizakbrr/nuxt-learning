generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  slug    String   @id
  title   String
  recipes Recipe[]
}

model Recipe {
  slug         String
  title        String
  cookTime     String
  description  String
  ingredients  String[]
  steps        String[]
  categorySlug String
  category     Category @relation(fields: [categorySlug], references: [slug])

  @@id([categorySlug, slug])
}
